   "name": "Auth",
   "item": [
    {
     "name": "Register creator",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/auth/register",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "auth",
        "register"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"Cara Creator\",\n  \"email\": \"cara@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"CREATOR\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const j=pm.response.json();pm.environment.set('creatorToken',j.token);pm.test('token saved',()=>pm.expect(j.token).to.be.a('string'));"
        ]
       }
      }
     ]
    },
